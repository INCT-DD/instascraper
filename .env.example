# Copy this file to .env and change the values before running Docker.

POSTGRES_DB=instagram_collector
POSTGRES_USER=collector
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

TIMEZONE=America/Bahia

COOKIE_JSON_PATH=cookies/collector-01.json
PROFILES_PATH=profiles.json
SESSIONS_PATH=sessions.json
DATA_DIR=data
LOGS_DIR=logs
REPORTS_DIR=reports
EXPORTS_DIR=exports
# Optional. Use a local OneDrive-synced folder on the host, for example:
# HOST_EXPORTS_DIR=C:/Users/Ricardo/OneDrive/Documentos/laboratorio/instagram-monitoring
HOST_EXPORTS_DIR=./exports
# Base export path. The pipeline appends the run date/period automatically:
# /app/exports/instagram_31-08-26 or /app/exports/instagram_30-08-26-to-31-08-26
CANDIDATE_ARCHIVE_DIR=/app/exports/instagram

RPS=1
MARGIN_DAYS=0
COLLECT_POSTS_DEFAULT=true
COLLECT_STORIES_DEFAULT=true
COLLECT_COMMENTS_DEFAULT=false
COLLECT_REPLIES_DEFAULT=false
COLLECT_POST_MEDIA=true
MEDIA_QUEUE_ENABLED=true
MEDIA_WORKER_SLEEP_SECONDS=10
MEDIA_QUEUE_LIMIT=25
POST_MEDIA_DIR=/app/exports/instagram
STORY_MEDIA_DIR=/app/exports/instagram
POST_MEDIA_TIMEOUT_SECONDS=60
MAX_JOB_ATTEMPTS=3
JOB_LIMIT_PER_RUN=100
MAX_COMMENTS_PER_POST=500
COMMENT_QUEUE_TIME_LIMIT_SECONDS=1800

ACCOUNT_ROTATION_ENABLED=false

GALLERY_DL_ENABLED=true
GALLERY_DL_BINARY=gallery-dl
GALLERY_DL_COOKIES=cookies/collector-01.txt
GALLERY_DL_SLEEP_REQUEST=6.0-12.0
GALLERY_DL_TIMEOUT_SECONDS=900

# Notifications for scheduled runs. Use provider telegram or email.
NOTIFY_ENABLED=false
NOTIFY_PROVIDER=telegram
NOTIFY_ON_SUCCESS=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email/SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
